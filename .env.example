NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=diyaa

# Dev: optional (weak default used if unset). Production: required, min 32 characters.
JWT_SECRET=

# Access token lifetime in seconds (default 86400 = 24h)
JWT_EXPIRES_SEC=86400

# Comma-separated browser origins (CORS). Default in code: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Groq — learning chatbot (https://console.groq.com)
GROQ_API_KEY=

# AWS Cognito (production Lambda only — keep false for local dev)
COGNITO_ENABLED=false
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# When NODE_ENV is not production: set false to disable TypeORM synchronize
TYPEORM_SYNC=true

# Platform SuperAdmin (seeded on startup — no public registration)
# Use a strong password (12+ chars). Never commit real credentials.
SUPERADMIN_EMAIL=product.owner@diyaa.local
SUPERADMIN_PASSWORD=hellodiyaa123!
SUPERADMIN_NAME=Product Owner
# Set true only to reset SuperAdmin password from .env on next restart
SUPERADMIN_SYNC_PASSWORD=false
