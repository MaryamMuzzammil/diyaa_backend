{
  "pipeline": {
    "name": "diyaa-backend-pipeline",
    "roleArn": "arn:aws:iam::932453197807:role/diyaa-pipeline-service-role",
    "artifactStore": {
      "type": "S3",
      "location": "diyaa-pipeline-artifacts-932453197807"
    },
    "stages": [
      {
        "name": "Source",
        "actions": [
          {
            "name": "GitHubSource",
            "actionTypeId": {
              "category": "Source",
              "owner": "AWS",
              "provider": "CodeStarSourceConnection",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "ConnectionArn": "${CONNECTION_ARN}",
              "FullRepositoryId": "${GITHUB_REPO_FULL_NAME}",
              "BranchName": "${BRANCH_NAME}",
              "OutputArtifactFormat": "CODE_ZIP"
            },
            "outputArtifacts": [
              {
                "name": "SourceOutput"
              }
            ],
            "inputArtifacts": []
          }
        ]
      },
      {
        "name": "Build",
        "actions": [
          {
            "name": "BuildAndDeploy",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "ProjectName": "diyaa-backend-build"
            },
            "outputArtifacts": [
              {
                "name": "BuildOutput"
              }
            ],
            "inputArtifacts": [
              {
                "name": "SourceOutput"
              }
            ]
          }
        ]
      }
    ]
  }
}
